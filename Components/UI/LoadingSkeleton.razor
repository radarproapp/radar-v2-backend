@* Reusable loading skeleton component *@

<div class="r-skeleton r-skeleton--@(Variant)">
    @if (Variant == "text")
    {
        <div class="r-skeleton__line" style="width:@(Width ?? "100%");"></div>
        @if (Lines > 1)
        {
            <div class="r-skeleton__line" style="width:80%;"></div>
        }
        @if (Lines > 2)
        {
            <div class="r-skeleton__line" style="width:60%;"></div>
        }
    }
    else if (Variant == "card")
    {
        <div class="r-skeleton__card">
            <div class="r-skeleton__rect" style="height:140px;"></div>
            <div style="padding:16px;">
                <div class="r-skeleton__line" style="width:60%;margin-bottom:10px;"></div>
                <div class="r-skeleton__line" style="width:100%;margin-bottom:6px;"></div>
                <div class="r-skeleton__line" style="width:80%;"></div>
            </div>
        </div>
    }
    else if (Variant == "avatar")
    {
        <div class="r-skeleton__avatar"></div>
        <div style="flex:1;">
            <div class="r-skeleton__line" style="width:40%;margin-bottom:8px;"></div>
            <div class="r-skeleton__line" style="width:60%;"></div>
        </div>
    }
    else if (Variant == "feed")
    {
        @for (var i = 0; i < Count; i++)
        {
            <div class="r-skeleton__feed-item">
                <div class="r-skeleton__rect" style="width:60px;height:60px;border-radius:10px;"></div>
                <div style="flex:1;">
                    <div class="r-skeleton__line" style="width:30%;margin-bottom:8px;"></div>
                    <div class="r-skeleton__line" style="width:90%;margin-bottom:6px;"></div>
                    <div class="r-skeleton__line" style="width:65%;"></div>
                </div>
            </div>
        }
    }
    else if (Variant == "stats")
    {
        <div class="r-skeleton__stats-grid">
            @for (var i = 0; i < 4; i++)
            {
                <div class="r-skeleton__stat">
                    <div class="r-skeleton__line" style="width:50%;margin-bottom:10px;"></div>
                    <div class="r-skeleton__line" style="width:30%;height:28px;margin-bottom:6px;"></div>
                    <div class="r-skeleton__line" style="width:40%;"></div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Variant { get; set; } = "text";
    [Parameter] public int Lines { get; set; } = 2;
    [Parameter] public int Count { get; set; } = 3;
    [Parameter] public string? Width { get; set; }
}
