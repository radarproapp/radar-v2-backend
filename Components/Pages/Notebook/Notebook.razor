@page "/notebook"
@rendermode InteractiveServer
@inherits RadarV2.Components.Base.SessionAwareBase
@inject INotebookService NotebookService

<PageTitle>Notebook — Radar</PageTitle>

<div class="r-page">
    <div class="r-page-head" style="display:flex;align-items:center;justify-content:space-between;">
        <h1 class="r-page-title">Notebook</h1>
        <button class="btn btn--primary btn--sm" @onclick='() => Nav.NavigateTo("/notebook/new")'>+ New note</button>
    </div>

    <p class="r-page-sub" style="margin-bottom:20px;">Your own thinking, connected to what you have read and what you are learning.</p>

    @if (_error is not null)
    {
        <ErrorState Title="Failed to load notes" Description="@_error" OnRetry="LoadAsync" />
    }
    else if (_loading)
    {
        <LoadingSkeleton Variant="feed" Count="3" />
    }
    else if (_notes.Count == 0)
    {
        <EmptyState Icon="ðŸ"" Title="No notes yet." Description="Capture your thinking as you read and learn. Notes link back to the content that inspired them.">
            <button class="btn btn--primary btn--sm" @onclick='() => Nav.NavigateTo("/capture")'>Capture something</button>
        </EmptyState>
    }
    else
    {
        <div style="display:flex;flex-direction:column;gap:10px;">
            @foreach (var note in _notes)
            {
                <a href="/notebook/@note.Id" style="display:block;background:#fff;border:1px solid rgba(20,24,31,.1);border-radius:14px;padding:17px 19px;text-decoration:none;color:inherit;">
                    <div style="font-family:var(--font-display);font-weight:700;font-size:14.5px;line-height:1.4;margin-bottom:5px;">@note.Title</div>
                    <div style="font-size:12.5px;color:var(--text-dim);line-height:1.6;margin-bottom:10px;">@Truncate(note.Body, 120)</div>
                    <div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap;">
                        @if (note.LinkedItemIds.Count > 0)
                        {
                            <span style="font-size:11px;font-weight:700;color:var(--cyan-deep);background:var(--cyan-light);border-radius:99px;padding:4px 10px;">Linked to @note.LinkedItemIds.Count item@(note.LinkedItemIds.Count > 1 ? "s" : "")</span>
                        }
                        @foreach (var tag in note.Tags.Take(3))
                        {
                            <span style="font-size:11px;font-weight:600;background:#f0f2f4;border-radius:99px;padding:4px 10px;">#@tag</span>
                        }
                        <span style="font-size:11.5px;color:var(--text-faint);font-weight:600;margin-left:auto;">Edited @DateHelper.Humanize(note.EditedAt)</span>
                    </div>
                </a>
            }
        </div>
    }
</div>

@code {
    private List<Note> _notes = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnAuthenticatedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _notes = await NotebookService.GetNotesAsync(Profile!.Id);
        }
        catch (Exception ex)
        {
            _error = "Could not load notes. " + ex.Message;
        }
        _loading = false;
    }

    private static string Truncate(string text, int max) =>
        text.Length <= max ? text : text[..max] + "â€¦";
}
