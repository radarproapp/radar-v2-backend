@page "/notebook/{NoteId}"
@rendermode InteractiveServer
@inherits RadarV2.Components.Base.SessionAwareBase
@inject INotebookService NotebookService

<PageTitle>Note — Radar</PageTitle>

<div class="note-editor-shell">

    <!-- Header -->
    <div class="note-editor-header">
        <a href="/notebook" style="font-size:18px;color:var(--text);">â†</a>
        <span style="font-size:12px;font-weight:600;color:var(--text-faint);flex:1;">
            @(_note is not null ? $"Edited {DateHelper.Humanize(_note.EditedAt)}" : "")
        </span>
        <button class="btn btn--tonal btn--sm" @onclick='() => Nav.NavigateTo("/ask")'>Ask Radar</button>
    </div>

    @if (_note is not null)
    {
        <div style="flex:1;width:100%;max-width:680px;margin:0 auto;padding:clamp(20px,3.5vw,32px) clamp(18px,4vw,40px) 40px;">

            <!-- Title -->
            <input type="text" value="@_note.Title" @oninput="OnTitleChange"
                   class="note-editor-title-input" />

            <!-- Tags -->
            <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:22px;">
                @foreach (var tag in _note.Tags)
                {
                    <span class="note-tag">#@tag</span>
                }
            </div>

            <!-- Body -->
            <textarea value="@_note.Body" @oninput="OnBodyChange"
                      class="note-editor-body"></textarea>

            <!-- Radar noticed -->
            @if (_note.LinkedItemIds.Count > 0)
            {
                <div class="note-radar-noticed">
                    <div class="note-radar-noticed-label">RADAR NOTICED</div>
                    <p style="font-size:13.5px;color:#374151;line-height:1.7;margin-bottom:13px;">Your closing question is partly answered by a paper in your saved library.</p>
                    <div style="display:flex;gap:8px;flex-wrap:wrap;">
                        <a class="btn btn--primary btn--sm" href="/">Open the paper</a>
                        <button class="btn btn--sm">Link to this note</button>
                    </div>
                </div>
            }

            <!-- Linked items -->
            <div style="margin-top:20px;font-size:12px;color:var(--text-faint);line-height:1.65;">
                @if (_note.LinkedItemIds.Count > 0)
                {
                    <span>Linked: @string.Join(" Â· ", _note.LinkedItemIds.Select(id => $"Item {id}"))</span>
                }
            </div>

        </div>
    }
    else
    {
        <div class="r-empty"><div class="r-spinner"></div></div>
    }
</div>

@code {
    [Parameter] public string NoteId { get; set; } = "";
    private Note? _note;

    protected override async Task OnAuthenticatedAsync()
    {
        _note = await NotebookService.GetNoteByIdAsync(NoteId);
    }

    private void OnTitleChange(ChangeEventArgs e)
    {
        if (_note is not null)
            _note.Title = e.Value?.ToString() ?? string.Empty;
    }

    private void OnBodyChange(ChangeEventArgs e)
    {
        if (_note is not null)
            _note.Body = e.Value?.ToString() ?? string.Empty;
    }
}
