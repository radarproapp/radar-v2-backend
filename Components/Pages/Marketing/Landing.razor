@page "/landing"
@page "/m"
@layout MarketingLayout

<div class="mkt-landing">

    <!-- HERO -->
    <section class="mkt-hero">
        <div class="mkt-hero__content">
            <div class="mkt-hero__badge">Africa's Intelligence Operating System</div>
            <h1 class="mkt-hero__title">Turn everything you read into something you can act on.</h1>
            <p class="mkt-hero__desc">Radar reads the news, research and reports piling up around you, explains what actually matters, and turns that understanding into skills, proof of capability, and better decisions — for you, and for the institutions you belong to.</p>
            <div class="mkt-hero__actions">
                <a href="/" class="btn btn--accent btn--lg">Start free</a>
                <a href="/institutions" class="btn btn--outline-dark btn--lg">For institutions →</a>
            </div>
        </div>
        <div class="mkt-hero__visual">
            <div class="mkt-hero__photo"></div>
            <div class="mkt-hero__stat-card">
                <div class="mkt-hero__stat">
                    <div class="mkt-hero__stat-val" style="color:#00c2cb;">18</div>
                    <div class="mkt-hero__stat-label">Day streak</div>
                </div>
                <div class="mkt-hero__stat">
                    <div class="mkt-hero__stat-val" style="color:#fff;">143</div>
                    <div class="mkt-hero__stat-label">Resources</div>
                </div>
            </div>
        </div>
    </section>

    <!-- PROBLEM -->
    <section class="mkt-problem">
        <div class="mkt-problem__inner">
            <div class="mkt-problem__header">
                <div class="mkt-section-label">The intelligence gap</div>
                <h2>You've never had less time, or more information.</h2>
                <p>Search engines find things. Courses end. Chat tools answer one question at a time. None of them build a lasting, connected understanding of your world — that's the gap Radar closes.</p>
            </div>
            <div class="mkt-problem__cards">
                <div class="mkt-card">
                    <div class="mkt-card__icon">🔍</div>
                    <div class="mkt-card__title">Google finds it. It doesn't explain it.</div>
                    <div class="mkt-card__desc">You still have to decide what's trustworthy, what's current, and what it means for you.</div>
                </div>
                <div class="mkt-card">
                    <div class="mkt-card__icon">🎓</div>
                    <div class="mkt-card__title">Courses end. Learning shouldn't.</div>
                    <div class="mkt-card__desc">Most learning platforms go quiet the moment the syllabus finishes — right when the real world keeps moving.</div>
                </div>
                <div class="mkt-card">
                    <div class="mkt-card__icon">💬</div>
                    <div class="mkt-card__title">AI chat answers one question.</div>
                    <div class="mkt-card__desc">Radar builds the whole picture — connecting months of reading into one growing body of knowledge.</div>
                </div>
            </div>
        </div>
    </section>

    <!-- PRODUCT TEASER -->
    <section class="mkt-products">
        <div class="mkt-products__inner">
            <div class="mkt-section-row">
                <div>
                    <div class="mkt-section-label">One system, four applications</div>
                    <h2>Everything runs on the same intelligence.</h2>
                </div>
                <a href="/product" class="mkt-link-arrow">Explore all products →</a>
            </div>
            <div class="mkt-products__grid">
                <a href="/product" class="mkt-product-card">
                    <div class="mkt-product-card__icon mkt-product-card__icon--teal">
                        <div style="width:16px;height:16px;border-radius:50%;border:1.8px solid #008c93;display:flex;align-items:center;justify-content:center;"><div style="width:5px;height:5px;border-radius:50%;background:#008c93;"></div></div>
                    </div>
                    <div class="mkt-product-card__title">Radar Intelligence</div>
                    <div class="mkt-product-card__desc">Understand the world in five minutes a day.</div>
                </a>
                <a href="/product" class="mkt-product-card">
                    <div class="mkt-product-card__icon mkt-product-card__icon--amber">
                        <div style="display:flex;align-items:flex-end;gap:2.5px;height:16px;">
                            <div style="width:4px;height:7px;border-radius:1px;background:#b7791a;"></div>
                            <div style="width:4px;height:11.5px;border-radius:1px;background:#b7791a;"></div>
                            <div style="width:4px;height:16px;border-radius:1px;background:#b7791a;"></div>
                        </div>
                    </div>
                    <div class="mkt-product-card__title">Radar Learn</div>
                    <div class="mkt-product-card__desc">Structured pathways toward a real skill.</div>
                </a>
                <a href="/product" class="mkt-product-card">
                    <div class="mkt-product-card__icon mkt-product-card__icon--indigo">
                        <div style="position:relative;width:15px;height:16px;">
                            <div style="width:14px;height:14px;border-radius:50%;background:#5b6bd9;"></div>
                            <div style="position:absolute;top:10.5px;left:4px;width:0;height:0;border-left:3px solid transparent;border-right:3px solid transparent;border-top:5px solid #5b6bd9;"></div>
                        </div>
                    </div>
                    <div class="mkt-product-card__title">Radar Career</div>
                    <div class="mkt-product-card__desc">A living portfolio that proves your capability.</div>
                </a>
                <a href="/product" class="mkt-product-card">
                    <div class="mkt-product-card__icon mkt-product-card__icon--green">
                        <div style="position:relative;width:16px;height:16px;">
                            <div style="position:absolute;left:2px;bottom:3px;width:10px;height:1.8px;border-radius:1px;background:#1f9d63;transform-origin:0% 100%;transform:rotate(-35deg);"></div>
                            <div style="position:absolute;top:1px;right:1px;width:4.5px;height:4.5px;border-top:1.8px solid #1f9d63;border-right:1.8px solid #1f9d63;transform:rotate(45deg);"></div>
                        </div>
                    </div>
                    <div class="mkt-product-card__title">Radar Insights</div>
                    <div class="mkt-product-card__desc">Live dashboards for institutional leaders.</div>
                </a>
            </div>
        </div>
    </section>

    <!-- INSTITUTIONS TEASER -->
    <section class="mkt-institutions-teaser">
        <div class="mkt-institutions-teaser__inner">
            <div class="mkt-section-row">
                <div>
                    <div class="mkt-section-label">Built for institutions</div>
                    <h2>Every leader gets the view they need.</h2>
                </div>
                <a href="/institutions" class="mkt-link-arrow">See institution dashboards →</a>
            </div>
            <div class="mkt-inst-grid">
                <a href="/institutions" class="mkt-inst-card">
                    <div class="mkt-inst-card__img" style="background:linear-gradient(135deg,#1a3a4a,#0d2530);"></div>
                    <div class="mkt-inst-card__name">Universities</div>
                </a>
                <a href="/institutions" class="mkt-inst-card">
                    <div class="mkt-inst-card__img" style="background:linear-gradient(135deg,#1a2a3a,#0d1820);"></div>
                    <div class="mkt-inst-card__name">Banks & enterprises</div>
                </a>
                <a href="/institutions" class="mkt-inst-card">
                    <div class="mkt-inst-card__img" style="background:linear-gradient(135deg,#2a2a3a,#181820);"></div>
                    <div class="mkt-inst-card__name">Government</div>
                </a>
                <a href="/institutions" class="mkt-inst-card">
                    <div class="mkt-inst-card__img" style="background:linear-gradient(135deg,#1a3a2a,#0d2018);"></div>
                    <div class="mkt-inst-card__name">NGOs & partners</div>
                </a>
            </div>
        </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="mkt-testimonials">
        <div class="mkt-testimonials__inner">
            <div class="mkt-section-label">A day with Radar</div>
            <h2>Real people, real decisions.</h2>
            <div class="mkt-testimonials__grid">
                <div class="mkt-testimonial-card">
                    <div class="mkt-testimonial-card__img" style="background:linear-gradient(135deg,#1a3040,#0d1f2a);"></div>
                    <div class="mkt-testimonial-card__body">
                        <div class="mkt-testimonial-card__name">Ada</div>
                        <div class="mkt-testimonial-card__role">200-level Economics student</div>
                        <p>"Instead of a 180-page report, Radar gave me five minutes that explained what mattered — then turned it into a project for my portfolio."</p>
                    </div>
                </div>
                <div class="mkt-testimonial-card">
                    <div class="mkt-testimonial-card__img" style="background:linear-gradient(135deg,#1a2a3a,#0d1a25);"></div>
                    <div class="mkt-testimonial-card__body">
                        <div class="mkt-testimonial-card__name">David</div>
                        <div class="mkt-testimonial-card__role">Software engineer, 29</div>
                        <p>"Ten minutes every morning instead of two hours of blogs. A year in, my manager noticed the consistency — and promoted me."</p>
                    </div>
                </div>
                <div class="mkt-testimonial-card">
                    <div class="mkt-testimonial-card__img" style="background:linear-gradient(135deg,#2a2a30,#1a1a20);"></div>
                    <div class="mkt-testimonial-card__body">
                        <div class="mkt-testimonial-card__name">Mr. Okafor</div>
                        <div class="mkt-testimonial-card__role">Managing Director, Manufacturing</div>
                        <p>"Five minutes on Radar and I walk into the executive meeting already informed — competitors, costs, regulation, all of it."</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="mkt-cta-section">
        <div class="mkt-cta-card">
            <div class="mkt-cta-card__content">
                <h2>Ready to turn information into intelligence?</h2>
                <p>Start free as an individual, or bring Radar to your university, bank, government agency, or organisation.</p>
            </div>
            <div class="mkt-cta-card__actions">
                <a href="/" class="btn btn--dark btn--lg">Start free</a>
                <a href="/institutions" class="btn btn--outline-white btn--lg">Talk to us about your institution</a>
            </div>
        </div>
    </section>

</div>
