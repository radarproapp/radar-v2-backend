        ContentLayer.Skills         => "Skills",
        ContentLayer.RealEstate     => "Real Estate",
        ContentLayer.Law            => "Law",
        ContentLayer.Literature     => "Literature",
        ContentLayer.Transportation => "Transport",
        ContentLayer.Gaming         => "Gaming",
        ContentLayer.Art            => "Art",
        ContentLayer.History        => "History",
        ContentLayer.Sports         => "Sports",
        ContentLayer.Music          => "Music",
        ContentLayer.Film           => "Film & TV",
        ContentLayer.Science        => "Science",
        ContentLayer.Environment    => "Environment",
        ContentLayer.Travel         => "Travel",
        ContentLayer.Medicine       => "Medicine",
        ContentLayer.Fashion        => "Fashion",
        ContentLayer.Lifestyle      => "Lifestyle",
        ContentLayer.Faith          => "Faith",
        ContentLayer.Philosophy     => "Philosophy",
        ContentLayer.Education      => "Education",
        ContentLayer.Finance        => "Finance",
        ContentLayer.Energy         => "Energy",
        ContentLayer.Agriculture    => "Agriculture",
        ContentLayer.Industry       => "Industry",
        ContentLayer.Career         => "Career",
        _                           => "Intelligence"
    };

    private static string LayerColor(ContentLayer layer) => layer switch
    {
        ContentLayer.Policy         => "#0e5f6b",
        ContentLayer.Academic       => "#1a4d8f",
        ContentLayer.Ideas          => "#6b3fa0",
        ContentLayer.RealEstate     => "#b45309",
        ContentLayer.Law            => "#1e3a5f",
        ContentLayer.Literature     => "#713f12",
        ContentLayer.Transportation => "#44495e",
        ContentLayer.Gaming         => "#5b21b6",
        ContentLayer.Art            => "#9d174d",
        ContentLayer.History        => "#92400e",
        ContentLayer.Sports         => "#14532d",
        ContentLayer.Music          => "#831843",
        ContentLayer.Film           => "#7f1d1d",
        ContentLayer.Science        => "#0f766e",
        ContentLayer.Environment    => "#166534",
        ContentLayer.Travel         => "#0c4a6e",
        ContentLayer.Medicine       => "#991b1b",
        ContentLayer.Fashion        => "#7e22ce",
        ContentLayer.Lifestyle      => "#c2410c",
        ContentLayer.Faith          => "#78350f",
        ContentLayer.Philosophy     => "#3b0764",
        ContentLayer.Education      => "#1e3a8a",
        ContentLayer.Finance        => "#064e3b",
        ContentLayer.Energy         => "#78350f",
        ContentLayer.Agriculture    => "#3f6212",
        ContentLayer.Industry       => "#374151",
        ContentLayer.Career         => "#1e3a8a",
        _                           => "#374151"
    };

    private static string LayerBg(ContentLayer layer) => layer switch
    {
        ContentLayer.Policy         => "#e0f4f6",
        ContentLayer.Academic       => "#ddeeff",
        ContentLayer.Ideas          => "#ede9f7",
        ContentLayer.RealEstate     => "#fef3c7",
        ContentLayer.Law            => "#e8f0fe",
        ContentLayer.Literature     => "#fefce8",
        ContentLayer.Transportation => "#f0f4f8",
        ContentLayer.Gaming         => "#ede9fe",
        ContentLayer.Art            => "#fce7f3",
        ContentLayer.History        => "#fff7ed",
        ContentLayer.Sports         => "#dcfce7",
        ContentLayer.Music          => "#fdf2f8",
        ContentLayer.Film           => "#fef2f2",
        ContentLayer.Science        => "#f0fdfa",
        ContentLayer.Environment    => "#f0fdf4",
        ContentLayer.Travel         => "#e0f2fe",
        ContentLayer.Medicine       => "#fee2e2",
        ContentLayer.Fashion        => "#f3e8ff",
        ContentLayer.Lifestyle      => "#fff7ed",
        ContentLayer.Faith          => "#fffbeb",
        ContentLayer.Philosophy     => "#faf5ff",
        ContentLayer.Education      => "#eff6ff",
        ContentLayer.Finance        => "#d1fae5",
        ContentLayer.Energy         => "#fef3c7",
        ContentLayer.Agriculture    => "#ecfccb",
        ContentLayer.Industry       => "#f0f2f4",
        ContentLayer.Career         => "#dbeafe",
        _                           => "#f0f2f4"
    };

    private async Task ToggleSave()
    {
        if (_item is null || Profile is null) return;
        if (_item.IsSaved)
        {
            await FeedService.UnsaveItemAsync(Profile.Id, _item.Id);
            _item.IsSaved = false;
        }
        else
        {
            await FeedService.SaveItemAsync(Profile.Id, _item.Id);
            _item.IsSaved = true;
        }
    }

    private async Task AddToRoadmap()
    {
        if (Profile is null || _addedToRoadmap) return;
        await RoadmapService.AddTopicToRoadmapAsync(Profile.Id, "active", _item?.Topic ?? "");
        _addedToRoadmap = true;
    }
}
