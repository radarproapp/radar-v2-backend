# Copy to .env for `docker compose up`. .env is gitignored; never commit a filled-in copy.
#
# Every one of these is optional. Leave a line blank and the feature it powers reports itself
# unconfigured on /api/version instead of failing when a user first touches it.

# Signs login tokens. Any string works locally; use `openssl rand -base64 32` for a real one.
Auth__Jwt__Key=local-development-only-key-not-a-secret-32b

# Without this the AI features return their deterministic fallbacks, which is fine for most work.
OpenRouter__ApiKey=

# Without this, Learn links to YouTube search results rather than resolving specific videos.
YouTube__ApiKey=

OpenAlex__ApiKey=

# Authenticates the scheduled-job endpoints. Only needs to match what you pass to curl.
Jobs__CronKey=local-cron-key
