<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- The build is warning-free today; this keeps it that way. A warning that nobody has to
             fix is a warning everybody learns to scroll past. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <!-- The web SDK globs **/*.cs, which would pull the test project's sources into the app.
         Tests live under tests/ and belong to their own project. -->
    <ItemGroup>
      <Compile Remove="tests/**" />
      <Content Remove="tests/**" />
      <None Remove="tests/**" />
      <EmbeddedResource Remove="tests/**" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
      <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
      <PackageReference Include="MongoDB.Driver" Version="3.11.1" />
      <PackageReference Include="PdfPig" Version="0.1.16" />
    </ItemGroup>

  <ItemGroup>
    <!-- The test project sees internals, so inference that is easy to get quietly wrong - which
         opportunity type a posting is, what its deadline says - can be tested directly rather
         than through a feed nobody can run in a test. -->
    <InternalsVisibleTo Include="RadarV2.Tests" />
  </ItemGroup>

</Project>
